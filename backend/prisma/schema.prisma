generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Visita {
  id          Int      @id @default(autoincrement())
  nombre      String
  apPaterno   String
  apMaterno   String
  genero      String
  createdAt   DateTime @default(now())
}
